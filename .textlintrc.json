{
  "plugins": {
    "@textlint/markdown": true
  },
  "filters": {},
  "rules": {
    "preset-ja-technical-writing": {
      "no-doubled-conjunction": true,
      "ja-no-abusage": true,
      "max-kanji-continuous-len": { "max": 8 },
      "no-exclamation-question-mark": false,
      "ja-no-mixed-period": { "allowPeriodMarks": ["。", "."] },
      "no-dead-link": false
    },
    "preset-jtf-style": {
      "2.1.2.漢字": false,
      "2.1.5.カタカナ": false,
      "2.2.1.ひらがなと漢字の使い分け": false
    },
    "no-dead-link": {
      "ignoreRedirects": true,
      "skipLocalhost": true,
      "skip": [
        "https://github.com/minoru365/DX-CrossBoundary-Strategy/actions",
        "https://localhost/*"
      ]
    }
  }
}
